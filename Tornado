-- ============================================================================
-- 1. EXCLUSION FILTER & BASELINE STATE RECORDER
-- ============================================================================
local function isExcludedPart(part)
	if not part or not part:IsA("BasePart") then return true end
	if part.Name == "Baseplate" or part.Name == "Terrain" or part:IsDescendantOf(ScorchFolder) then return true end
	if part:GetAttribute("IsTornadoComponent") or part:GetAttribute("StormInterceptor") then return true end

	-- Protect player character and equipped tools
	local char = LocalPlayer.Character
	if char and part:IsDescendantOf(char) then return true end
	if part:FindFirstAncestorWhichIsA("Tool") then return true end

	-- Anti-Ground-Suck Safeguard: Ignore floor geometry directly at or underneath player's feet
	local _, root = getCharacterData()
	if root then
		local horizontalDist = (Vector2.new(part.Position.X, part.Position.Z) - Vector2.new(root.Position.X, root.Position.Z)).Magnitude
		local verticalDiff = part.Position.Y - (root.Position.Y - 3)
		if horizontalDist < 18 and verticalDiff <= 0.5 then
			return true
		end
	end

	return false
end

local function recordOriginalState(part)
	if not OriginalPartStates[part] and part and part.Parent then
		OriginalPartStates[part] = {
			CFrame = part.CFrame,
			Anchored = part.Anchored,
			CanCollide = part.CanCollide,
			Parent = part.Parent
		}
	end
end

