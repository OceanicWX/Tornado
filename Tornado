(math.random() - 0.5) * coreShake,
(math.random() - 0.5) * coreShake
)
elseif closestVortexDist < 340 then
local shakeMag = math.clamp(1 - (closestVortexDist / 340), 0, 1) * 1.35
hum.CameraOffset = Vector3.new(
