elseif closestVortexDist <= primaryFocusTornado.SuctionRange or PlayerInVortex then
PlayerInVortex = true
PlayerHoldTime = PlayerHoldTime + dt
PlayerOrbitAngle = PlayerOrbitAngle + (6.5 * dt)
if PlayerHoldTime < 2.2 then
local orbitR = math.max(14, primaryFocusTornado.CurrentBaseWidth * 0.55)
local targetX = primaryFocusTornado.BasePart.Position.X + math.cos(PlayerOrbitAngle) * orbitR
local targetZ = primaryFocusTornado.BasePart.Position.Z + math.sin(PlayerOrbitAngle) * orbitR
root.AssemblyLinearVelocity = Vector3.new(
(targetX - root.Position.X) * 14,
28,
(targetZ - root.Position.Z) * 14
)
else
local ejectDir = (root.Position - primaryFocusTornado.BasePart.Position)
ejectDir = Vector3.new(ejectDir.X, 0, ejectDir.Z).Unit
if ejectDir.Magnitude == 0 then ejectDir = Vector3.new(1, 0, 0) end
root.AssemblyLinearVelocity = (ejectDir * (primaryFocusTornado.WindSpeed * 1.15)) + Vector3.new(0, 125, 0)
PlayerInVortex = false
PlayerHoldTime = 0
PlayerThrowCooldown = 3
end
else
PlayerHoldTime = 0
PlayerInVortex = false
end
end
