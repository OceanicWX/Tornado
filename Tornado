	local hum = char:FindFirstChild("Humanoid")
	return char, root, hum
end

-- Helper: Builds a smooth, gradual wedge size sequence where Top is always > Bottom
local function buildFunnelSizeSequence(baseW, topW, isWedge)
	local safeBase = math.max(4, baseW)
	local safeTop = math.max(safeBase + 25, topW)

	if isWedge then
		safeTop = math.max(math.floor(safeBase * 1.45), safeBase + 65, topW)
		local diff = safeTop - safeBase
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, safeBase),
			NumberSequenceKeypoint.new(0.33, safeBase + (diff * 0.28)),
			NumberSequenceKeypoint.new(0.66, safeBase + (diff * 0.65)),
			NumberSequenceKeypoint.new(1, safeTop)
		})
	else
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, safeBase),
			NumberSequenceKeypoint.new(0.5, safeBase + ((safeTop - safeBase) * 0.45)),
			NumberSequenceKeypoint.new(1, safeTop)
		})
	end
end

-- Helper: Returns true if tornado meets EF2+ strength to break joints and unanchor structures
local function canBreakAnchoredStructures(tornadoObj)
	if not tornadoObj then return false end
	return (tornadoObj.WindSpeed >= EF2_MIN_WIND_MPH) and (tornadoObj.CurrentBaseWidth >= EF2_MIN_BASE_WIDTH)
end

-- ============================================================================
-- 1. EXCLUSION FILTER, BELOW-PLAYER PROTECTION & EF2 STRUCTURAL GATE
-- ============================================================================
local function isInsideExcludedGroup(instance)
	local current = instance
	while current and current ~= workspace do
		if EXCLUDED_GROUP_NAMES[current.Name] then
			return true
		end
		current = current.Parent
	end
	return false
end

local function isExcludedPart(part, tornadoObj)
	if not part or not part:IsA("BasePart") then return true end
	if part.Name == "Baseplate" or part:IsA("Terrain") or part:IsDescendantOf(ScorchFolder) then return true end
	if part:GetAttribute("IsTornadoComponent") or part:GetAttribute("StormInterceptor") or part:GetAttribute("WeatherProbe") then return true end

	if isInsideExcludedGroup(part) then
		return true
	end

	local char = LocalPlayer.Character
	if char and part:IsDescendantOf(char) then return true end
	if part:FindFirstAncestorWhichIsA("Tool") then return true end

	-- Strict Anti-Ground / Below-Player Safeguard
	local _, root = getCharacterData()
	if root then
		local playerFeetY = root.Position.Y - 2.8
		local partTopY = part.Position.Y + (part.Size.Y * 0.5)
		if partTopY <= playerFeetY then
			return true
		end
	end

	-- Sub-EF2 Rule: If windspeed < EF2 (111 MPH) OR size < EF2 (45 studs),
	-- ignore anchored structures completely (only affect already-unanchored objects)
	if tornadoObj and not canBreakAnchoredStructures(tornadoObj) then
		if part.Anchored then
			return true
		end
	end

	-- Size-Based Debris Threshold (Scales with Tornado Base Width)
	if tornadoObj then
		local maxAllowedDimension = math.max(12, tornadoObj.CurrentBaseWidth * 0.65)
		local largestAxis = math.max(part.Size.X, part.Size.Y, part.Size.Z)
		if largestAxis > maxAllowedDimension then
			return true
		end
	end

	return false
end

local function recordOriginalState(part)
	if not OriginalPartStates[part] and part and part.Parent then
		OriginalPartStates[part] = {
			CFrame = part.CFrame,
			Anchored = part.Anchored,
			CanCollide = part.CanCollide,
			Parent = part.Parent
		}
	end
end

