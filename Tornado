local function ResetMap()
    for _, b in pairs(MapBackup) do
        if b.Object and b.Object.Parent then
            b.Object.CFrame, b.Object.Anchored, b.Object.CanCollide = b.CFrame, b.Anchored, b.CanCollide
            b.Object.AssemblyLinearVelocity, b.Object.AssemblyAngularVelocity = Vector3.new(0,0,0), Vector3.new(0,0,0)
            b.Object:SetAttribute("CapturedByVortex", nil)
        end
    end
end

