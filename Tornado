local function createPresetButton(preset, buttonColor)
local pBtn = Instance.new("TextButton")
pBtn.Size = UDim2.new(0.92, 0, 0, 26)
pBtn.BackgroundColor3 = buttonColor
pBtn.TextColor3 = Color3.fromRGB(225, 238, 255)
