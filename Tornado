pBtn.Text = "Deploy: " .. preset.Name
pBtn.Parent = mainFrame
Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
pBtn.MouseButton1Click:Connect(function()
SimulationConfig.BaseWidth = preset.BaseWidth
SimulationConfig.TopMaxSize = preset.TopMaxSize
SimulationConfig.Height = preset.Height
SimulationConfig.SuctionRange = preset.SuctionRange
SimulationConfig.WindSpeed = preset.WindSpeed
SimulationConfig.MovementSpeed = preset.MovementSpeed
SimulationConfig.SelectedVariant = preset.Variant
for k, box in pairs(inputBoxes) do
if SimulationConfig[k] then
box.Text = tostring(SimulationConfig[k])
end
end
variantBtn.Text = "Variant: " .. preset.Variant
spawnTornado(preset)
end)
end
