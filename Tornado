local function dropScorchAndBeam(tornadoObj, prevAttachment)
local origin = tornadoObj.BasePart.Position + Vector3.new(0, 15, 0)
local result = workspace:Raycast(origin, Vector3.new(0, -40, 0), RayParams)
local hitPos = result and result.Position or tornadoObj.BasePart.Position
local scorchPart = Instance.new("Part")
scorchPart.Size = Vector3.new(tornadoObj.BaseWidth * 1.1, 0.15, tornadoObj.BaseWidth * 1.1)
scorchPart.CFrame = CFrame.new(hitPos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
scorchPart.Anchored = true
scorchPart.CanCollide = false
scorchPart.Material = Enum.Material.Slate
scorchPart.Color = tornadoObj.Variant == "DustDevil" and Color3.fromRGB(130, 95, 65) or Color3.fromRGB(48, 42, 36)
scorchPart.Transparency = 0.35
scorchPart:SetAttribute("IsTornadoComponent", true)
scorchPart.Parent = ScorchFolder
local nodePart = Instance.new("Part")
nodePart.Size = Vector3.new(1, 1, 1)
nodePart.Transparency = 1
nodePart.Anchored = true
nodePart.CanCollide = false
nodePart.CFrame = CFrame.new(hitPos + Vector3.new(0, 3, 0))
nodePart:SetAttribute("IsTornadoComponent", true)
nodePart.Parent = ScorchFolder
local att = Instance.new("Attachment", nodePart)
if prevAttachment and prevAttachment.Parent then
local beam = Instance.new("Beam")
beam.Attachment0 = prevAttachment
beam.Attachment1 = att
beam.Width0 = math.max(4, tornadoObj.BaseWidth * 0.4)
