data.HeightOffset = data.HeightOffset + (55 * dt)
if data.HeightOffset > t.Height * 0.9 then data.HeightOffset = 5 end
local tightRadius = math.max(5, t.BaseWidth * 0.35)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle * 1.4) * tightRadius, data.HeightOffset, math.sin(data.Angle * 1.4) * tightRadius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 12
elseif data.Behavior == "Thrown" then
data.HeightOffset = data.HeightOffset + (38 * dt)
data.Radius = data.Radius + (18 * dt)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle) * data.Radius, data.HeightOffset, math.sin(data.Angle) * data.Radius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 7
if data.HeightOffset >= t.Height * 0.65 then
local tangent = Vector3.new(-math.sin(data.Angle), 0.45, math.cos(data.Angle)).Unit
part.AssemblyLinearVelocity = tangent * (t.WindSpeed * 1.35)
part.CanCollide = true
CapturedDebris[part] = nil
end
end
end
-- G. Player Suction & Throw Physics
if root and hum and primaryFocusTornado and SimulationConfig.PlayerSuctionEnabled then
if PlayerThrowCooldown > 0 then
PlayerThrowCooldown = PlayerThrowCooldown - dt
elseif closestVortexDist <= primaryFocusTornado.SuctionRange or PlayerInVortex then
PlayerInVortex = true
PlayerHoldTime = PlayerHoldTime + dt
PlayerOrbitAngle = PlayerOrbitAngle + (6.5 * dt)
if PlayerHoldTime < 2.2 then
local orbitR = math.max(14, primaryFocusTornado.BaseWidth * 0.55)
local targetX = primaryFocusTornado.BasePart.Position.X + math.cos(PlayerOrbitAngle) * orbitR
local targetZ = primaryFocusTornado.BasePart.Position.Z + math.sin(PlayerOrbitAngle) * orbitR
root.AssemblyLinearVelocity = Vector3.new(
(targetX - root.Position.X) * 14,
28,
(targetZ - root.Position.Z) * 14
)
else
local ejectDir = (root.Position - primaryFocusTornado.BasePart.Position)
ejectDir = Vector3.new(ejectDir.X, 0, ejectDir.Z).Unit
if ejectDir.Magnitude == 0 then ejectDir = Vector3.new(1, 0, 0) end
root.AssemblyLinearVelocity = (ejectDir * (primaryFocusTornado.WindSpeed * 1.15)) + Vector3.new(0, 125, 0)
PlayerInVortex = false
PlayerHoldTime = 0
PlayerThrowCooldown = 3
end
else
PlayerHoldTime = 0
PlayerInVortex = false
end
end
-- H. Ambient Weather Shader Interpolation, Rain Scaling & Camera Shake
if #ActiveTornadoes > 0 and SimulationConfig.WeatherPipelineActive then
-- Time-of-day overcast sky shader interpolation
local mins = Lighting:GetMinutesAfterMidnight()
local targetFogColor = Color3.fromRGB(65, 70, 78)
if mins >= 360 and mins < 660 then -- Morning
targetFogColor = Color3.fromRGB(110, 118, 128)
elseif mins >= 660 and mins < 1020 then -- High-exposure overcast afternoon
targetFogColor = Color3.fromRGB(165, 172, 180)
elseif mins >= 1020 and mins < 1170 then -- Sunset storm purple-gray
targetFogColor = Color3.fromRGB(92, 72, 98)
else -- Mid-storm slate black night
targetFogColor = Color3.fromRGB(22, 25, 32)
end
Lighting.FogColor = Lighting.FogColor:Lerp(targetFogColor, dt * 2)
Lighting.Ambient = Lighting.Ambient:Lerp(targetFogColor, dt * 2)
Lighting.FogEnd = 900
-- Proximity-Anchored Volumetric Rain Scaling
if PlayerRainEmitter and primaryFocusTornado then
if primaryFocusTornado.Variant == "DustDevil" or closestVortexDist > 600 then
PlayerRainEmitter.Rate = 0
else
local intensity = math.clamp(1 - (closestVortexDist / 600), 0, 1)
PlayerRainEmitter.Rate = math.floor(intensity * 550)
end
end
-- Proximity-Responsive Camera Shake Engine
if hum and closestVortexDist < 320 and not SimulationConfig.AerialViewActive then
local shakeMag = math.clamp(1 - (closestVortexDist / 320), 0, 1) * 1.45
hum.CameraOffset = Vector3.new(
(math.random() - 0.5) * shakeMag,
(math.random() - 0.5) * shakeMag,
(math.random() - 0.5) * shakeMag
)
elseif hum then
hum.CameraOffset = Vector3.zero
end
else
if PlayerRainEmitter then PlayerRainEmitter.Rate = 0 end
if hum then hum.CameraOffset = Vector3.zero end
end
-- I. Aerial Tracker Map Top-Down Orthographic Camera Lock
if SimulationConfig.AerialViewActive and primaryFocusTornado and primaryFocusTornado.BasePart then
Camera.CameraType = Enum.CameraType.Scriptable
local focusPos = primaryFocusTornado.BasePart.Position
Camera.CFrame = CFrame.lookAt(focusPos + Vector3.new(0, 520, 1), focusPos)
end
end)
table.insert(ActiveConnections, renderConn)
end
