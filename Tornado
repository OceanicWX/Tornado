local function CheckAndSuckUnanchoredParts(cfg)
    if not CurrentBaseAnchor or not CurrentBaseAnchor.Parent then return end
    local radiusToCheck = (cfg.MaxSize * 0.5) + 80
    local parts = workspace:GetPartBoundsInRadius(CurrentBaseAnchor.Position, radiusToCheck)
    
    local lowestPointY = RootPart.Position.Y - 3
    local characterFlatPos = Vector3.new(RootPart.Position.X, 0, RootPart.Position.Z)

    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and not part:GetAttribute("CapturedByVortex") then
            local pName = part.Name
            if pName ~= "Baseplate" and pName ~= "SpawnedStormInterceptor" and pName ~= "SpawnedStormInterceptor2" and pName ~= "Delta_VehicleInstance" and pName ~= "DeltaVehicle_Instance" and pName ~= "BasePlate" and not part:IsDescendantOf(Character) and not part:IsDescendantOf(CurrentTornado) and pName ~= "SimulationBase" and pName ~= "MesoStormCloud" and pName ~= "Tornado_Scorches" and not part:IsDescendantOf(ScorchFolder) then
                local pPos = part.Position
                local partFlatPos = Vector3.new(pPos.X, 0, pPos.Z)
                local horizontalDistanceToPlayer = (partFlatPos - characterFlatPos).Magnitude
                local directlyUnderFeet = (horizontalDistanceToPlayer < 2.5) and (pPos.Y <= lowestPointY + 0.1)

                if pPos.Y > lowestPointY and not directlyUnderFeet then
                    if part.Parent and part.Parent:IsA("Model") then
                        part.Parent:BreakJoints()
                    end
                    part:BreakJoints()
                    
                    if not MapBackup[part] then 
                        MapBackup[part] = { Object = part, CFrame = part.CFrame, Anchored = part.Anchored, CanCollide = part.CanCollide } 
                    end
                    
                    part.Anchored = false
                    part.CanCollide = false
                    part:SetAttribute("CapturedByVortex", true)
                    
                    local behaviorChance = math.random(1, 100)
                    local assignedBehavior = (behaviorChance <= 25 and "Thrown") or (behaviorChance <= 50 and "KeptInFunnel") or "RotateInside"
                    table.insert(SimulatedDebrisList, {
                        Instance = part, Behavior = assignedBehavior, Angle = math.atan2(pPos.Z - CurrentBaseAnchor.Position.Z, pPos.X - CurrentBaseAnchor.Position.X),
                        HeightOffset = math.clamp(pPos.Y - CurrentBaseAnchor.Position.Y, 5, 250), Radius = (partFlatPos - Vector3.new(CurrentBaseAnchor.Position.X, 0, CurrentBaseAnchor.Position.Z)).Magnitude, UpwardLiftSpeed = math.random(8, 20), FallbackTimer = 0
                    })
                end
            end
        end
    end
end

