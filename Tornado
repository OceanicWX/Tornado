local T = _G.TornadoSystem

T.ExecuteRenderSubLoop = function(dt, baseAnchor, cfg, runtimeTicker, velocityMagnitude, angularPlayerOrbit)
        for idx = #T.CurrentActiveSubvortices, 1, -1 do
            local sub = T.CurrentActiveSubvortices[idx]
            if (runtimeTicker - sub.SpawnTime) > sub.Duration or not sub.Part.Parent then sub.Part:Destroy() table.remove(T.CurrentActiveSubvortices, idx) else
                sub.OffsetAngle = sub.OffsetAngle + (2.5 * dt)
                sub.Part.CFrame = CFrame.new(baseAnchor.Position.X + math.cos(sub.OffsetAngle) * (cfg.Width + math.sin(runtimeTicker) * 15), baseAnchor.Position.Y, baseAnchor.Position.Z + math.sin(sub.OffsetAngle) * (cfg.Width + math.sin(runtimeTicker) * 15))
            end
        end

        if math.random(1, 5) == 1 then T.CheckAndSuckUnanchoredParts(cfg) end

        for idx = #T.SimulatedDebrisList, 1, -1 do
            local deb = T.SimulatedDebrisList[idx]
            if not deb.Instance or not deb.Instance.Parent then table.remove(T.SimulatedDebrisList, idx) else
                local pPart = deb.Instance local dPos = pPart.Position local flatCorePos = Vector3.new(baseAnchor.Position.X, 0, baseAnchor.Position.Z) local flatPartPos = Vector3.new(dPos.X, 0, dPos.Z) local currentDist = (flatPartPos - flatCorePos).Magnitude local suctionThreshold = (cfg.MaxSize * 0.5) + 60
                if currentDist > suctionThreshold or deb.Behavior == "Released" then
                    deb.Behavior, deb.FallbackTimer = "Released", deb.FallbackTimer + dt if deb.FallbackTimer > 4 then pPart:SetAttribute("CapturedByVortex", nil) table.remove(T.SimulatedDebrisList, idx) end
                else
                    if deb.Behavior == "RotateInside" then local radialTarget = math.clamp(currentDist - (20 * dt), cfg.Width + 5, suctionThreshold) deb.Angle = deb.Angle + ((velocityMagnitude / math.max(currentDist, 10)) * dt) deb.HeightOffset = math.clamp(deb.HeightOffset + (deb.UpwardLiftSpeed * dt), 5, cfg.Height - 50) pPart.AssemblyLinearVelocity = (Vector3.new(baseAnchor.Position.X + math.cos(deb.Angle) * radialTarget, baseAnchor.Position.Y + deb.HeightOffset, baseAnchor.Position.Z + math.sin(deb.Angle) * radialTarget) - dPos) * 6 pPart.AssemblyAngularVelocity = Vector3.new(math.sin(runtimeTicker), math.cos(runtimeTicker), math.sin(runtimeTicker)) * 2
                    elseif deb.Behavior == "KeptInFunnel" then deb.Angle = deb.Angle + ((velocityMagnitude * 1.4 / math.max(currentDist, 5)) * dt) deb.HeightOffset = math.clamp(deb.HeightOffset + ((deb.UpwardLiftSpeed * 0.3) * dt), 5, 200) pPart.AssemblyLinearVelocity = (Vector3.new(baseAnchor.Position.X + math.cos(deb.Angle) * (cfg.Width * 0.8), baseAnchor.Position.Y + deb.HeightOffset, baseAnchor.Position.Z + math.sin(deb.Angle) * (cfg.Width * 0.8)) - dPos) * 8 pPart.AssemblyAngularVelocity = Vector3.new(0, 4, 0)
                    elseif deb.Behavior == "Thrown" then deb.Angle = deb.Angle + ((velocityMagnitude * 0.8 / math.max(currentDist, 10)) * dt) deb.HeightOffset = deb.HeightOffset + (deb.UpwardLiftSpeed * 1.2 * dt) local dynamicScatterRadius = currentDist + (45 * dt)
                        if dynamicScatterRadius > (cfg.MaxSize * 0.45) or deb.HeightOffset > 300 then local tangentVelocity = (flatPartPos - flatCorePos).Unit local dynamicReleaseVector = (Vector3.new(-tangentVelocity.Z, 0, tangentVelocity.X) * 0.75 + tangentVelocity * 0.5).Unit pPart.AssemblyLinearVelocity = (dynamicReleaseVector * (cfg.WindSpeed * 0.95)) + Vector3.new(0, math.random(40, 90), 0) deb.Behavior, deb.FallbackTimer = "Released", 0
                        else pPart.AssemblyLinearVelocity = (Vector3.new(baseAnchor.Position.X + math.cos(deb.Angle) * dynamicScatterRadius, baseAnchor.Position.Y + deb.HeightOffset, baseAnchor.Position.Z + math.sin(deb.Angle) * dynamicScatterRadius) - dPos) * 5 end
                    end
                end
            end
        end

        if T.Character:FindFirstChild("Humanoid") and T.RootPart then
            local currentDistanceToCore = (Vector3.new(T.RootPart.Position.X, 0, T.RootPart.Position.Z) - Vector3.new(baseAnchor.Position.X, 0, baseAnchor.Position.Z)).Magnitude
            local activeSuctionLimit = (cfg.MaxSize * 0.5) + 30 local coreThreshold = cfg.Width + 10
            if currentDistanceToCore <= activeSuctionLimit then
                if currentDistanceToCore <= coreThreshold then
                    if T.Humanoid then T.Humanoid.CameraOffset = Vector3.new(0,0,0) end
                    if cfg.PlayerSuction then angularPlayerOrbit = angularPlayerOrbit + (0.5 * dt) T.RootPart.AssemblyLinearVelocity = (Vector3.new(baseAnchor.Position.X + math.cos(angularPlayerOrbit) * currentDistanceToCore, T.RootPart.Position.Y, baseAnchor.Position.Z + math.sin(angularPlayerOrbit) * currentDistanceToCore) - T.RootPart.Position) * 3 end
                else
                    if T.Humanoid then local intensity = math.clamp((1 - (currentDistanceToCore / activeSuctionLimit)) * 1.5, 0.1, 1.8) T.Humanoid.CameraOffset = Vector3.new(math.random(-100, 100) * 0.008 * intensity, math.random(-100, 100) * 0.008 * intensity, math.random(-100, 100) * 0.008 * intensity) end
                    if cfg.PlayerSuction then angularPlayerOrbit = angularPlayerOrbit + ((velocityMagnitude / math.max(currentDistanceToCore, 10)) * dt)
                        local rotX = baseAnchor.Position.X + math.cos(angularPlayerOrbit) * math.clamp(currentDistanceToCore - (12 * dt), coreThreshold + 2, activeSuctionLimit) local rotZ = baseAnchor.Position.Z + math.sin(angularPlayerOrbit) * math.clamp(currentDistanceToCore - (12 * dt), coreThreshold + 2, activeSuctionLimit)
                        T.RootPart.AssemblyLinearVelocity = Vector3.new((rotX - T.RootPart.Position.X) * (overrideConfig and overrideConfig.Suction or 12) * 0.7, 28, (rotZ - T.RootPart.Position.Z) * (overrideConfig and overrideConfig.Suction or 12) * 0.7)
                    end
                end
            elseif T.Humanoid then T.Humanoid.CameraOffset = Vector3.new(0,0,0) end
        end
end
