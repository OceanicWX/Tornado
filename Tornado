-- G. Update Triple-Track Kinetic Debris Physics
for part, data in pairs(CapturedDebris) do
local t = data.Tornado
if not part or not part.Parent or not t or not t.BasePart or not t.BasePart.Parent then
CapturedDebris[part] = nil
continue
end
local angularSpeed = (t.WindSpeed / 35)
data.Angle = data.Angle + (angularSpeed * dt)
if data.Behavior == "RotateInside" then
data.HeightOffset = data.HeightOffset + (22 * dt)
if data.HeightOffset > t.Height * 0.85 then data.HeightOffset = 8 end
local targetRadius = (t.CurrentBaseWidth * 0.5) + ((data.HeightOffset / t.Height) * (t.CurrentTopSize * 0.45))
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle) * targetRadius, data.HeightOffset, math.sin(data.Angle) * targetRadius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 8
part.AssemblyAngularVelocity = Vector3.new(5, 8, 4)
elseif data.Behavior == "KeptInFunnel" then
data.HeightOffset = data.HeightOffset + (55 * dt)
if data.HeightOffset > t.Height * 0.9 then data.HeightOffset = 5 end
local tightRadius = math.max(5, t.CurrentBaseWidth * 0.35)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle * 1.4) * tightRadius, data.HeightOffset, math.sin(data.Angle * 1.4) * tightRadius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 12
elseif data.Behavior == "Thrown" then
data.HeightOffset = data.HeightOffset + (38 * dt)
data.Radius = data.Radius + (18 * dt)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle) * data.Radius, data.HeightOffset, math.sin(data.Angle) * data.Radius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 7
if data.HeightOffset >= t.Height * 0.65 then
local tangent = Vector3.new(-math.sin(data.Angle), 0.45, math.cos(data.Angle)).Unit
part.AssemblyLinearVelocity = tangent * (t.WindSpeed * 1.35)
part.CanCollide = true
CapturedDebris[part] = nil
end
end
end
