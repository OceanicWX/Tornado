T.CoreRenderPhysicsLoop = function(cfg, baseAnchor, funnelEmitter, stormCloud, hasInterceptedPlayer, currentTargetWaypoint, GetNewRandomWaypoint, lastPathTime, currentDescentScale, runtimeTicker, angularPlayerOrbit, rainEmitter)
    T.CurrentRenderConnection = T.RunService.RenderStepped:Connect(function(dt)
        if not baseAnchor or not baseAnchor.Parent then return end
        runtimeTicker = runtimeTicker + dt

        local computedTopSize = cfg.MaxSize
        local baseWidth = cfg.Width
        
        if baseWidth <= 200 then
            baseWidth = cfg.Width + (math.sin(runtimeTicker * 2.5) * (cfg.Width * 0.3))
            computedTopSize = cfg.MaxSize + (math.cos(runtimeTicker * 1.8) * (cfg.MaxSize * 0.2))
        end

        local distanceToVortex = (Vector3.new(T.RootPart.Position.X, 0, T.RootPart.Position.Z) - Vector3.new(baseAnchor.Position.X, 0, baseAnchor.Position.Z)).Magnitude
        local localizedProximityFactor = math.clamp(1 - (distanceToVortex / 1200), 0.05, 1)

        if rainEmitter and rainEmitter.Parent then
            rainEmitter.Rate = 450 * localizedProximityFactor
        end

        local hour = T.Lighting:GetMinutesAfterMidnight() / 60
        local baseAmbientColor = Color3.fromRGB(35, 35, 38)
        local baseFogDensity = 0.65
        
        if hour >= 6 and hour < 11 then
            baseAmbientColor = Color3.fromRGB(45, 45, 48)
            baseFogDensity = 0.55
        elseif hour >= 11 and hour < 17 then
            baseAmbientColor = Color3.fromRGB(115, 115, 120)
            baseFogDensity = 0.45
        elseif hour >= 17 and hour < 20 then
            baseAmbientColor = Color3.fromRGB(30, 26, 30)
            baseFogDensity = 0.70
        else
            baseAmbientColor = Color3.fromRGB(8, 8, 12)
            baseFogDensity = 0.85
        end

        local currentFinalColor = baseAmbientColor
        if math.random(1, 140) == 1 then
            currentFinalColor = Color3.fromRGB(240, 245, 255)
            T.Lighting.ExposureCompensation = 3
            task.delay(0.06, function() T.Lighting.ExposureCompensation = 0 end)
        end

        T.Lighting.OutdoorAmbient = T.Lighting.OutdoorAmbient:Lerp(currentFinalColor, dt * 1.5)
        T.Lighting.FogColor = T.Lighting.FogColor:Lerp(baseAmbientColor, dt * 1.5)
        T.Lighting.FogEnd = math.max(100, T.Lighting.FogEnd - ((T.Lighting.FogEnd - (1200 * (1 - baseFogDensity))) * dt * 0.8))

        if currentDescentScale < 1 then
            currentDescentScale = math.min(1, currentDescentScale + (dt / 4))
            funnelEmitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, baseWidth), NumberSequenceKeypoint.new(math.clamp(0.5 * currentDescentScale, 0.01, 0.98), (computedTopSize * 0.4) * currentDescentScale), NumberSequenceKeypoint.new(math.clamp(1 * currentDescentScale, 0.02, 1), computedTopSize * currentDescentScale)})
        else
            funnelEmitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, baseWidth), NumberSequenceKeypoint.new(0.5, computedTopSize * 0.45), NumberSequenceKeypoint.new(1, computedTopSize)})
        end

        stormCloud.CFrame = baseAnchor.CFrame * CFrame.new(0, cfg.Height, 0)
        local targetPosition = (cfg.InterceptTargetOnce and not hasInterceptedPlayer and T.RootPart.Position) or (cfg.MovementMode == "Follow Player" and T.RootPart.Position) or currentTargetWaypoint
        
        if cfg.InterceptTargetOnce and not hasInterceptedPlayer and (Vector3.new(baseAnchor.Position.X, 0, baseAnchor.Position.Z) - Vector3.new(T.RootPart.Position.X, 0, T.RootPart.Position.Z)).Magnitude < 25 then
            hasInterceptedPlayer, currentTargetWaypoint = true, GetNewRandomWaypoint()
        end

        local translationVector = (Vector3.new(targetPosition.X, baseAnchor.Position.Y, targetPosition.Z) - baseAnchor.Position)
        if translationVector.Magnitude < 20 and cfg.MovementMode == "Random" and not (cfg.InterceptTargetOnce and not hasInterceptedPlayer) then
            currentTargetWaypoint = GetNewRandomWaypoint()
        else
            baseAnchor.CFrame = CFrame.new(baseAnchor.Position + (translationVector.Unit * cfg.Speed * dt))
        end

        if runtimeTicker - lastPathTime > 0.4 then
            local ray = workspace:Raycast(baseAnchor.Position + Vector3.new(0, 10, 0), Vector3.new(0, -50, 0)) local groundPos = ray and ray.Position or baseAnchor.Position
            local sc = Instance.new("Part", T.ScorchFolder) sc.Size, sc.Transparency, sc.Anchored, sc.CanCollide, sc.CFrame = Vector3.new(baseWidth * 1.5, 0.1, baseWidth * 1.5), 1, true, false, CFrame.new(groundPos) * CFrame.Angles(0, math.random(0, 360), 0)
            local d = Instance.new("Decal", sc) d.Texture, d.Face, d.Color3 = T.SCORCH_DECAL(T.SCORCH_DECAL_ID), Enum.NormalId.Top, Color3.fromRGB(110, 85, 60)
            local pAtt = Instance.new("Attachment", sc) table.insert(T.PathPoints, { Position = groundPos, Attachment = pAtt })
            if #T.PathPoints > 1 then 
                local prev = T.PathPoints[#T.PathPoints - 1] local b = Instance.new("Beam", sc) b.Attachment0, b.Attachment1, b.Width0, b.Width1, b.Color, b.FaceCamera = prev.Attachment, pAtt, 4, 4, ColorSequence.new(Color3.fromRGB(255, 80, 0)), true 
                b.Enabled = T.TrackingActive
                T.PathPoints[#T.PathPoints].Beam = b 
            end
            lastPathTime = runtimeTicker
        end

        if T.CurrentSatelliteTornado and T.CurrentSatelliteTornado:FindFirstChild("SimulationBase") then
            local satPart = T.CurrentSatelliteTornado.SimulationBase local orbitRadius = (computedTopSize * 0.6) + 40
            satPart.CFrame = CFrame.new(baseAnchor.Position.X + math.cos(runtimeTicker * 0.2) * orbitRadius, baseAnchor.Position.Y, baseAnchor.Position.Z + math.sin(runtimeTicker * 0.2) * orbitRadius)
        end

        if computedTopSize > 150 and math.random(1, 100) <= 4 and #T.CurrentActiveSubvortices < 4 then
            local subBase = Instance.new("Part", T.CurrentTornado) subBase.Size, subBase.Transparency, subBase.Anchored, subBase.CanCollide = Vector3.new(2,1,2), 1, true, false
            local subAttach = Instance.new("Attachment", subBase) local subEmitter = Instance.new("ParticleEmitter", subAttach)
            subEmitter.Texture, subEmitter.Rate, subEmitter.Lifetime, subEmitter.Speed, subEmitter.Acceleration, subEmitter.Color = "rbxasset://textures/particles/smoke_main.dds", 90, NumberRange.new(2, 4), NumberRange.new(30, 60), Vector3.new(0, 15, 0), ColorSequence.new(Color3.fromRGB(90,90,95))
            subEmitter.Size, subEmitter.RotSpeed = NumberSequence.new({NumberSequenceKeypoint.new(0, baseWidth * 0.4), NumberSequenceKeypoint.new(1, computedTopSize * 0.25)}), NumberRange.new(600, 1200)
            table.insert(T.CurrentActiveSubvortices, { Part = subBase, OffsetAngle = math.random(0, 360), SpawnTime = runtimeTicker, Duration = math.random(5, 12) })
        end

        local currentCopiedConfig = { MaxSize = computedTopSize, Width = baseWidth, Height = cfg.Height, WindSpeed = cfg.WindSpeed, PlayerSuction = cfg.PlayerSuction }
        T.ExecuteRenderSubLoop(dt, baseAnchor, currentCopiedConfig, runtimeTicker, cfg.WindSpeed * 0.45, angularPlayerOrbit)
        
        if T.TrackingActive then
            for _, p in ipairs(T.PathPoints) do if p.Beam then p.Beam.Enabled = true end end
        end
    end)
end

