T.CheckAndSuckUnanchoredParts = function(cfg)
    local regionSize = Vector3.new(cfg.MaxSize + 150, cfg.Height, cfg.MaxSize + 150)
    local region = Region3.new(T.CurrentBaseAnchor.Position - regionSize/2, T.CurrentBaseAnchor.Position + regionSize/2)
    local parts = workspace:FindPartsInRegion3WithIgnoreList(region, {T.CurrentTornado, T.Character, T.ScorchFolder}, 200)
    
    local lowestPointY = T.RootPart.Position.Y - 3
    local characterFlatPos = Vector3.new(T.RootPart.Position.X, 0, T.RootPart.Position.Z)

    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and not part:GetAttribute("CapturedByVortex") then
            local pName = part.Name
            if pName ~= "Baseplate" and pName ~= "SpawnedStormInterceptor" and pName ~= "SpawnedStormInterceptor2" and pName ~= "Delta_VehicleInstance" and not part.Parent:FindFirstChildOfClass("Humanoid") then
                local pPos = part.Position
                local partFlatPos = Vector3.new(pPos.X, 0, pPos.Z)
                local horizontalDistanceToPlayer = (partFlatPos - characterFlatPos).Magnitude
                local directlyUnderFeet = (horizontalDistanceToPlayer < 2.5) and (pPos.Y <= lowestPointY + 0.1)

                if pPos.Y > lowestPointY and not directlyUnderFeet then
                    local dist = (Vector3.new(pPos.X, 0, pPos.Z) - Vector3.new(T.CurrentBaseAnchor.Position.X, 0, T.CurrentBaseAnchor.Position.Z)).Magnitude
                    if dist < (cfg.MaxSize * 0.5) + 50 then
                        if not T.MapBackup[part] then T.MapBackup[part] = { Object = part, CFrame = part.CFrame, Anchored = part.Anchored, CanCollide = part.CanCollide } end
                        part.Anchored, part.CanCollide = false, false part:SetAttribute("CapturedByVortex", true)
                        local behaviorChance = math.random(1, 100)
                        local assignedBehavior = (behaviorChance <= 25 and "Thrown") or (behaviorChance <= 50 and "KeptInFunnel") or "RotateInside"
                        table.insert(T.SimulatedDebrisList, {
                            Instance = part, Behavior = assignedBehavior, Angle = math.atan2(pPos.Z - T.CurrentBaseAnchor.Position.Z, pPos.X - T.CurrentBaseAnchor.Position.X),
                            HeightOffset = math.clamp(pPos.Y - T.CurrentBaseAnchor.Position.Y, 5, 250), Radius = dist, UpwardLiftSpeed = math.random(8, 20), FallbackTimer = 0
                        })
                    end
                end
            end
        end
    end
end
