local prevPos = t.BasePart.Position
if t.IsSubvortex and t.ParentTornado and t.ParentTornado.BasePart and t.ParentTornado.BasePart.Parent then
-- INTERNAL SUBVORTEX: Rapidly orbits inside the parent tornado's core boundary
t.OrbitAngle = t.OrbitAngle + (3.8 * dt)
local dynamicRadius = math.max(6, t.ParentTornado.BaseWidth * 0.5)
local offset = Vector3.new(math.cos(t.OrbitAngle) * dynamicRadius, 0, math.sin(t.OrbitAngle) * dynamicRadius)
t.BasePart.CFrame = CFrame.new(t.ParentTornado.BasePart.Position + offset)
if t.LifeDuration and t.ElapsedTime >= t.LifeDuration then
t.BasePart:Destroy()
t.SkyPart:Destroy()
table.remove(ActiveTornadoes, i)
continue
end
elseif t.IsSatellite then
-- INDEPENDENT SATELLITE TORNADO: Does its own thing, roaming freely within MaxSatelliteRange of parent
local parentActive = t.ParentTornado and t.ParentTornado.BasePart and t.ParentTornado.BasePart.Parent
if parentActive then
local parentPos = t.ParentTornado.BasePart.Position
local distFromParent = (Vector2.new(t.BasePart.Position.X, t.BasePart.Position.Z) - Vector2.new(parentPos.X, parentPos.Z)).Magnitude
-- If satellite wanders outside its allowed mesocyclone range, pick a new waypoint back inside range
if distFromParent > t.MaxSatelliteRange then
local pullAngle = math.random() * math.pi * 2
local pullDist = math.random(35, math.floor(t.MaxSatelliteRange * 0.65))
t.Waypoint = Vector3.new(
parentPos.X + math.cos(pullAngle) * pullDist,
t.BasePart.Position.Y,
parentPos.Z + math.sin(pullAngle) * pullDist
)
else
local dir = t.Waypoint - t.BasePart.Position
if dir.Magnitude < 16 then
local randAngle = math.random() * math.pi * 2
local randDist = math.random(30, math.floor(t.MaxSatelliteRange * 0.85))
t.Waypoint = Vector3.new(
parentPos.X + math.cos(randAngle) * randDist,
t.BasePart.Position.Y,
parentPos.Z + math.sin(randAngle) * randDist
)
end
end
local moveDir = t.Waypoint - t.BasePart.Position
if moveDir.Magnitude > 0.5 then
t.BasePart.CFrame = CFrame.new(t.BasePart.Position + (moveDir.Unit * t.MoveSpeed * dt))
end
else
-- Parent dissipated: satellite continues roaming independently across the map
local dir = t.Waypoint - t.BasePart.Position
if dir.Magnitude < 18 then
t.Waypoint = Vector3.new(
t.BasePart.Position.X + math.random(-500, 500),
t.BasePart.Position.Y,
t.BasePart.Position.Z + math.random(-500, 500)
)
else
t.BasePart.CFrame = CFrame.new(t.BasePart.Position + (dir.Unit * t.MoveSpeed * dt))
end
end
else
-- MASTER TORNADO MOVEMENT (Instant Strike Run-Over, Continuous Track, or Random Waypoint)
if SimulationConfig.InstantStrikeIntercept and root then
if not t.StrikeTargetPos then
t.StrikeTargetPos = Vector3.new(root.Position.X, t.BasePart.Position.Y, root.Position.Z)
local toTarget = t.StrikeTargetPos - t.BasePart.Position
t.StrikeHeading = (toTarget.Magnitude > 0.1) and toTarget.Unit or Vector3.new(0, 0, -1)
end
local step = t.StrikeHeading * t.MoveSpeed * dt
t.BasePart.CFrame = CFrame.new(t.BasePart.Position + step)
local remainingVec = t.StrikeTargetPos - t.BasePart.Position
local dot = remainingVec:Dot(t.StrikeHeading)
local clearanceDist = math.max(25, t.BaseWidth * 0.6)
if dot <= -clearanceDist then
t.StrikeTargetPos = nil
t.StrikeHeading = nil
SimulationConfig.InstantStrikeIntercept = false
if InstantStrikeToggleVisualRefresh then
InstantStrikeToggleVisualRefresh()
end
t.Waypoint = t.BasePart.Position + (Vector3.new(math.random(-100, 100), 0, math.random(-100, 100)).Unit * 600)
end
elseif SimulationConfig.TrackPlayerMode and root then
t.StrikeTargetPos = nil
local playerPos = Vector3.new(root.Position.X, t.BasePart.Position.Y, root.Position.Z)
local dir = playerPos - t.BasePart.Position
if dir.Magnitude > 1.5 then
t.BasePart.CFrame = CFrame.new(t.BasePart.Position + (dir.Unit * t.MoveSpeed * dt))
end
else
t.StrikeTargetPos = nil
local dir = t.Waypoint - t.BasePart.Position
if dir.Magnitude < 18 then
t.Waypoint = Vector3.new(
t.BasePart.Position.X + math.random(-650, 650),
t.BasePart.Position.Y,
t.BasePart.Position.Z + math.random(-650, 650)
)
else
t.BasePart.CFrame = CFrame.new(t.BasePart.Position + (dir.Unit * t.MoveSpeed * dt))
end
end
-- Giant Funnel 4% Dynamic Subvortex Spawn Check (every 2 seconds)
if t.TopMaxSize >= 200 and (t.ElapsedTime - t.LastSubvortexCheck) >= 2 then
t.LastSubvortexCheck = t.ElapsedTime
if math.random(1, 100) <= 4 then
spawnSubvorticesFor(t)
end
end
end
-- B. Sinuous Funnel Wave Physics & Barometric Breathing (Applies to Masters & Satellites)
local swayOffset = Vector3.zero
if t.TopMaxSize < 200 and not t.IsSubvortex then
local waveX = math.sin(t.ElapsedTime * 1.6) * 32 + math.cos(t.ElapsedTime * 0.9) * 14
local waveZ = math.cos(t.ElapsedTime * 1.4) * 32 + math.sin(t.ElapsedTime * 1.1) * 14
swayOffset = Vector3.new(waveX, 0, waveZ)
end
t.SkyPart.CFrame = t.BasePart.CFrame * CFrame.new(swayOffset.X, t.Height, swayOffset.Z)
if t.BaseWidth < 200 and not t.IsSubvortex then
local pulse = 1 + (math.sin(t.ElapsedTime * 2.4) * 0.18)
local currentBase = t.BaseWidth * pulse
if t.IsWedge then
t.FunnelEmitter.Size = NumberSequence.new({
NumberSequenceKeypoint.new(0, currentBase),
NumberSequenceKeypoint.new(0.35, currentBase * 1.05),
NumberSequenceKeypoint.new(0.75, t.TopMaxSize * 0.95),
NumberSequenceKeypoint.new(1, t.TopMaxSize)
})
else
t.FunnelEmitter.Size = NumberSequence.new({
NumberSequenceKeypoint.new(0, currentBase),
NumberSequenceKeypoint.new(0.5, t.TopMaxSize * 0.45),
NumberSequenceKeypoint.new(1, t.TopMaxSize)
})
end
end
-- C. Scorch Decal & Aerial Beam Logging (Masters & Satellites leave scorch tracks)
local movedDist = (t.BasePart.Position - prevPos).Magnitude
t.DistAccum = (t.DistAccum or 0) + movedDist
if not t.IsSubvortex and t.DistAccum >= 14 then
t.DistAccum = 0
t.LastBeamAttachment = dropScorchAndBeam(t, t.LastBeamAttachment)
end
-- D. Total Workspace Destruction Scanner
local scanRadius = t.SuctionRange * 1.15
local scanCenter = t.BasePart.Position + Vector3.new(0, t.Height * 0.35, 0)
local overlapParams = OverlapParams.new()
overlapParams.MaxParts = 70
local nearbyParts = workspace:GetPartBoundsInRadius(scanCenter, scanRadius, overlapParams)
for _, part in ipairs(nearbyParts) do
if not CapturedDebris[part] and not isExcludedPart(part, t) then
local horizDist = (Vector2.new(part.Position.X, part.Position.Z) - Vector2.new(t.BasePart.Position.X, t.BasePart.Position.Z)).Magnitude
if horizDist <= t.SuctionRange then
recordOriginalState(part)
local model = part:FindFirstAncestorWhichIsA("Model")
if model and model ~= workspace and not model:FindFirstChildOfClass("Humanoid") and not isInsideExcludedGroup(model) then
model:BreakJoints()
end
part:BreakJoints()
part.Anchored = false
part.CanCollide = false
local tracks = { "RotateInside", "KeptInFunnel", "Thrown" }
CapturedDebris[part] = {
Part = part,
Tornado = t,
Behavior = tracks[math.random(1, 3)],
Angle = math.random() * math.pi * 2,
HeightOffset = math.max(2, part.Position.Y - t.BasePart.Position.Y),
Radius = math.max(6, horizDist)
}
end
end
end
-- E. Track Closest Distance to Player
if root then
local pDist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(t.BasePart.Position.X, t.BasePart.Position.Z)).Magnitude
if pDist < closestVortexDist then
closestVortexDist = pDist
primaryFocusTornado = t
end
end
end
-- F. Update Triple-Track Kinetic Debris Physics
for part, data in pairs(CapturedDebris) do
local t = data.Tornado
if not part or not part.Parent or not t or not t.BasePart or not t.BasePart.Parent then
CapturedDebris[part] = nil
continue
end
local angularSpeed = (t.WindSpeed / 35)
data.Angle = data.Angle + (angularSpeed * dt)
if data.Behavior == "RotateInside" then
data.HeightOffset = data.HeightOffset + (22 * dt)
if data.HeightOffset > t.Height * 0.85 then data.HeightOffset = 8 end
local targetRadius = (t.BaseWidth * 0.5) + ((data.HeightOffset / t.Height) * (t.TopMaxSize * 0.45))
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle) * targetRadius, data.HeightOffset, math.sin(data.Angle) * targetRadius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 8
part.AssemblyAngularVelocity = Vector3.new(5, 8, 4)
elseif data.Behavior == "KeptInFunnel" then
data.HeightOffset = data.HeightOffset + (55 * dt)
if data.HeightOffset > t.Height * 0.9 then data.HeightOffset = 5 end
local tightRadius = math.max(5, t.BaseWidth * 0.35)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle * 1.4) * tightRadius, data.HeightOffset, math.sin(data.Angle * 1.4) * tightRadius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 12
elseif data.Behavior == "Thrown" then
data.HeightOffset = data.HeightOffset + (38 * dt)
data.Radius = data.Radius + (18 * dt)
local targetPos = t.BasePart.Position + Vector3.new(math.cos(data.Angle) * data.Radius, data.HeightOffset, math.sin(data.Angle) * data.Radius)
part.AssemblyLinearVelocity = (targetPos - part.Position) * 7
if data.HeightOffset >= t.Height * 0.65 then
local tangent = Vector3.new(-math.sin(data.Angle), 0.45, math.cos(data.Angle)).Unit
part.AssemblyLinearVelocity = tangent * (t.WindSpeed * 1.35)
part.CanCollide = true
CapturedDebris[part] = nil
end
end
end
-- G. Player Suction & Throw Physics
if root and hum and primaryFocusTornado and SimulationConfig.PlayerSuctionEnabled then
if PlayerThrowCooldown > 0 then
PlayerThrowCooldown = PlayerThrowCooldown - dt
elseif closestVortexDist <= primaryFocusTornado.SuctionRange or PlayerInVortex then
PlayerInVortex = true
PlayerHoldTime = PlayerHoldTime + dt
PlayerOrbitAngle = PlayerOrbitAngle + (6.5 * dt)
if PlayerHoldTime < 2.2 then
local orbitR = math.max(14, primaryFocusTornado.BaseWidth * 0.55)
local targetX = primaryFocusTornado.BasePart.Position.X + math.cos(PlayerOrbitAngle) * orbitR
local targetZ = primaryFocusTornado.BasePart.Position.Z + math.sin(PlayerOrbitAngle) * orbitR
root.AssemblyLinearVelocity = Vector3.new(
(targetX - root.Position.X) * 14,
28,
(targetZ - root.Position.Z) * 14
)
else
local ejectDir = (root.Position - primaryFocusTornado.BasePart.Position)
ejectDir = Vector3.new(ejectDir.X, 0, ejectDir.Z).Unit
if ejectDir.Magnitude == 0 then ejectDir = Vector3.new(1, 0, 0) end
root.AssemblyLinearVelocity = (ejectDir * (primaryFocusTornado.WindSpeed * 1.15)) + Vector3.new(0, 125, 0)
PlayerInVortex = false
PlayerHoldTime = 0
PlayerThrowCooldown = 3
end
else
PlayerHoldTime = 0
PlayerInVortex = false
end
end
-- H. Ambient Weather Shader Interpolation, Map-Wide Rain & Camera Shake
if #ActiveTornadoes > 0 and SimulationConfig.WeatherPipelineActive then
local mins = Lighting:GetMinutesAfterMidnight()
local targetFogColor = Color3.fromRGB(65, 70, 78)
if mins >= 360 and mins < 660 then
targetFogColor = Color3.fromRGB(110, 118, 128)
elseif mins >= 660 and mins < 1020 then
targetFogColor = Color3.fromRGB(165, 172, 180)
elseif mins >= 1020 and mins < 1170 then
targetFogColor = Color3.fromRGB(92, 72, 98)
else
targetFogColor = Color3.fromRGB(22, 25, 32)
end
Lighting.FogColor = Lighting.FogColor:Lerp(targetFogColor, dt * 2)
Lighting.Ambient = Lighting.Ambient:Lerp(targetFogColor, dt * 2)
Lighting.FogEnd = 900
if GlobalRainEmitter then
local hasRainStorm = false
for _, t in ipairs(ActiveTornadoes) do
if t.Variant ~= "DustDevil" then
hasRainStorm = true
break
end
end
if hasRainStorm then
local proximityBonus = math.clamp(1 - (closestVortexDist / 800), 0, 1) * 550
GlobalRainEmitter.Rate = math.floor(450 + proximityBonus)
else
GlobalRainEmitter.Rate = 0
end
end
if hum and closestVortexDist < 340 and not SimulationConfig.AerialViewActive then
local shakeMag = math.clamp(1 - (closestVortexDist / 340), 0, 1) * 1.45
hum.CameraOffset = Vector3.new(
(math.random() - 0.5) * shakeMag,
(math.random() - 0.5) * shakeMag,
(math.random() - 0.5) * shakeMag
)
elseif hum then
hum.CameraOffset = Vector3.zero
end
else
if GlobalRainEmitter then GlobalRainEmitter.Rate = 0 end
if hum then hum.CameraOffset = Vector3.zero end
end
-- I. Interactive Aerial Tracker Camera (Joystick/WASD Panning + Q/E/Scroll/Pinch Zoom)
if SimulationConfig.AerialViewActive then
Camera.CameraType = Enum.CameraType.Scriptable
local baseAnchor = (primaryFocusTornado and primaryFocusTornado.BasePart and primaryFocusTornado.BasePart.Position)
or (root and root.Position)
or Vector3.zero
local moveX, moveZ = 0, 0
if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then moveZ -= 1 end
if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then moveZ += 1 end
if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then moveX -= 1 end
if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then moveX += 1 end
if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
AerialCameraState.ZoomHeight = math.clamp(AerialCameraState.ZoomHeight - (320 * dt), 110, 1400)
end
if UserInputService:IsKeyDown(Enum.KeyCode.E) then
AerialCameraState.ZoomHeight = math.clamp(AerialCameraState.ZoomHeight + (320 * dt), 110, 1400)
end
if hum and hum.MoveDirection.Magnitude > 0.05 then
moveX += hum.MoveDirection.X
moveZ += hum.MoveDirection.Z
end
local panInput = Vector3.new(moveX, 0, moveZ)
if panInput.Magnitude > 1 then
panInput = panInput.Unit
end
local panSpeed = math.max(120, AerialCameraState.ZoomHeight * 0.75)
AerialCameraState.PanOffset += panInput * panSpeed * dt
local targetLookPos = baseAnchor + AerialCameraState.PanOffset
local camPos = targetLookPos + Vector3.new(0, AerialCameraState.ZoomHeight, 2)
Camera.CFrame = CFrame.lookAt(camPos, targetLookPos)
end
end)
table.insert(ActiveConnections, renderConn)
end
