local function spawnTornado(customConfig, isSubComponent)
	local _, root = getCharacterData()
	if not root then return end

	local cfg = customConfig or {}
	local variant = cfg.Variant or SimulationConfig.SelectedVariant

	-- RNG Weighted Attributes Selection
	if variant == "RNG" then
		local roll = math.random(1, 100)
		if roll <= 15 then
			variant = "DustDevil"
		elseif roll <= 28 then
			variant = "NonCondensation"
		else
			variant = "Normal"
		end

		cfg.BaseWidth = math.random(12, 95)
		cfg.TopMaxSize = math.random(math.max(cfg.BaseWidth + 40, 120), 360)
		cfg.Height = math.random(280, 440)
		cfg.SuctionRange = math.random(55, 190)
		cfg.WindSpeed = math.random(95, 280)
		cfg.MovementSpeed = math.random(6, 20)
	end

	local baseWidth = cfg.BaseWidth or SimulationConfig.BaseWidth
	local topMaxSize = cfg.TopMaxSize or SimulationConfig.TopMaxSize
	local cloudHeight = cfg.Height or SimulationConfig.Height
	local suctionRange = cfg.SuctionRange or SimulationConfig.SuctionRange
	local windSpeed = cfg.WindSpeed or SimulationConfig.WindSpeed
	local moveSpeed = cfg.MovementSpeed or SimulationConfig.MovementSpeed
	local spawnDist = cfg.SpawnDistance or SimulationConfig.SpawnDistance

	local spawnCFrame = cfg.OverrideCFrame or (root.CFrame * CFrame.new(0, 0, -spawnDist))

	-- 1. Core Ground Base Anchor
	local basePart = Instance.new("Part")
	basePart.Name = cfg.Name or ("TornadoCore_" .. variant)
	basePart.Size = Vector3.new(10, 1, 10)
	basePart.CFrame = CFrame.new(spawnCFrame.Position)
	basePart.Anchored = true
	basePart.CanCollide = false
	basePart.Transparency = 1
	basePart:SetAttribute("IsTornadoComponent", true)
	basePart.Parent = workspace

	-- 2. Audio Engine (Lowered dampening for Dust Devil)
	local tornadoSound = Instance.new("Sound")
	tornadoSound.Name = "VortexAudio"
	tornadoSound.SoundId = SOUND_ID
	tornadoSound.Looped = true
	if variant == "DustDevil" then
		tornadoSound.Volume = 0.65
		tornadoSound.RollOffMaxDistance = 260
		tornadoSound.Pitch = 1.25
	else
		tornadoSound.Volume = isSubComponent and 0.8 or 2.2
		tornadoSound.RollOffMaxDistance = isSubComponent and 350 or 850
	end
	tornadoSound.RollOffMinDistance = 20
	tornadoSound.Parent = basePart
tornadoSound:Play()
