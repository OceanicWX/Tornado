T.ResetMap = function()
    for _, b in ipairs(T.MapBackup) do
        if b.Object and b.Object.Parent then
            b.Object.CFrame, b.Object.Anchored, b.Object.CanCollide = b.CFrame, b.Anchored, b.CanCollide
            b.Object.AssemblyLinearVelocity, b.Object.AssemblyAngularVelocity = Vector3.new(0,0,0), Vector3.new(0,0,0)
            b.Object:SetAttribute("CapturedByVortex", nil)
        end
    end
end

T.ClearScorches = function()
    if T.ScorchFolder then T.ScorchFolder:Destroy() T.ScorchFolder = nil end
    for _, p in ipairs(T.PathPoints) do if p.Beam then p.Beam:Destroy() end end
    T.PathPoints = {}
end

T.ClearActiveTornado = function()
    if T.CurrentRenderConnection then T.CurrentRenderConnection:Disconnect() T.CurrentRenderConnection = nil end
    if T.CurrentTornado then T.CurrentTornado:Destroy() T.CurrentTornado = nil end
    T.CurrentActiveSubvortices = {}
    if T.CurrentSatelliteTornado then T.CurrentSatelliteTornado:Destroy() T.CurrentSatelliteTornado = nil end
    if T.DebrisFolder then T.DebrisFolder:Destroy() T.DebrisFolder = nil end
    if T.Humanoid then T.Humanoid.CameraOffset = Vector3.new(0,0,0) end
end
